---
layout: base.njk
title: Contact
permalink: /contact/
description: Get in touch with Sarah Olivia Thảo about available paintings, commissions or anything else.
bodyClass: page-contact
---
<section class="contact">
  <div class="wrap contact-grid">
    <div class="contact-intro">
      <p class="eyebrow reveal">Contact</p>
      <h1 class="page-title" data-split style="--d:1">Let’s <em>talk</em>.</h1>
      <p class="lead reveal" style="--d:2">Whether you’re interested in an available painting, have a question about a piece, or would just like to say hello, I’d love to hear from you.</p>

      <dl class="contact-details reveal" style="--d:3">
        <div>
          <dt>Email</dt>
          <dd><a href="#contact-form" data-email data-u="{{ site.email.user }}" data-d="{{ site.email.domain }}" data-email-text>{{ site.email.user }} [at] {{ site.email.domain }}</a></dd>
        </div>
        <div>
          <dt>Instagram</dt>
          <dd><a href="{{ site.instagram.url }}" rel="me noopener" target="_blank">@{{ site.instagram.handle }}</a></dd>
        </div>
        <div>
          <dt>Studio</dt>
          <dd>{{ site.studio }}</dd>
        </div>
      </dl>
    </div>

    <div class="contact-card reveal" style="--d:2">
      <form class="contact-form" id="contact-form" action="{{ site.formAction }}" method="POST" data-contact-form>
        <p class="form-about" data-about hidden>About <strong data-about-title></strong></p>
        <input type="hidden" name="_subject" value="New message from your website">
        <input type="hidden" name="painting" value="">

        <div class="field">
          <label for="f-name">Name</label>
          <input id="f-name" name="name" type="text" autocomplete="name" required>
        </div>
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" autocomplete="email" required>
        </div>
        <div class="field">
          <label for="f-topic">I’m interested in</label>
          <div class="select">
            <select id="f-topic" name="topic">
              <option>Buying a painting</option>
              <option>A commission</option>
              <option>Something else</option>
            </select>
          </div>
        </div>
        <div class="field">
          <label for="f-message">Message</label>
          <textarea id="f-message" name="message" rows="6" required></textarea>
        </div>
        <div class="hp" aria-hidden="true">
          <label>Leave this empty <input type="text" name="_gotcha" tabindex="-1" autocomplete="off"></label>
        </div>

        <button class="btn btn--block" type="submit">Send message</button>
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        <p class="form-note">Your message goes straight to Sarah’s inbox. See the <a href="/privacy/">privacy notice</a>.</p>
      </form>

      <div class="form-success" data-form-success hidden tabindex="-1">
        <img src="/assets/img/monogram.png" alt="" width="157" height="160" eleventy:ignore>
        <h2>Thank you.</h2>
        <p>Your message is on its way. I’ll get back to you as soon as I can.</p>
        <a class="link-arrow" href="/work/">Back to the work</a>
      </div>
    </div>
  </div>
</section>
