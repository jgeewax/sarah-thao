{#- Gallery card. Expects `artwork` (a collection item) in scope. -#}
{%- set a = artwork.data %}
<a class="card reveal" href="{{ artwork.url }}" data-status="{{ a.status }}">
  <div class="card-media">
    <img src="/artworks/{{ artwork.page.fileSlug }}/{{ a.images[0].src }}" alt="{{ a.images[0].alt }}" sizes="(min-width: 1100px) 400px, (min-width: 700px) 45vw, 92vw">
  </div>
  <div class="card-body">
    <div class="card-row">
      <h3 class="card-title">{{ a.title }}<span class="card-year">, {{ a.year }}</span></h3>
      {%- if a.status == "sold" %}
      <p class="card-status"><span class="dot dot--sold" aria-hidden="true"></span>Sold</p>
      {%- elif a.price %}
      <p class="card-status">{{ a.price }}</p>
      {%- endif %}
    </div>
    <p class="card-meta">{{ a.medium }}<br>{{ a.size }}</p>
  </div>
</a>
