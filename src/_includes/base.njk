<!doctype html>
<html lang="en-GB">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  {%- if title and page.url != "/" %}{% set pageTitle = title + " — " + site.name %}{% else %}{% set pageTitle = site.name + " — " + site.tagline %}{% endif %}
  {%- set pageDescription = description or site.description %}
  <title>{{ pageTitle }}</title>
  <meta name="description" content="{{ pageDescription }}">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:title" content="{{ pageTitle }}">
  <meta property="og:description" content="{{ pageDescription }}">
  <meta property="og:type" content="website">
  <meta property="og:locale" content="{{ site.locale }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- if site.url %}
  <link rel="canonical" href="{{ site.url }}{{ page.url }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  <meta property="og:image" content="{{ site.url }}{{ ogImage or '/artworks/civil-twilight/civil-twilight.jpg' }}">
  {%- endif %}
  <meta name="theme-color" content="#f6f2ec">
  <link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32" type="image/png">
  <link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
  <link rel="preload" href="/assets/fonts/fraunces-300-500-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/be-vietnam-pro-400-normal-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/fonts.css">
  <link rel="stylesheet" href="/assets/css/main.css">
  <script>document.documentElement.classList.add("js")</script>
  <script src="/assets/js/main.js" defer></script>
  {%- if page.url == "/" %}
  <script type="application/ld+json">
  {"@context":"https://schema.org","@type":"Person","name":{{ site.name | json | safe }},"jobTitle":"Artist","description":{{ site.description | json | safe }},"sameAs":[{{ site.instagram.url | json | safe }}]{% if site.url %},"url":{{ site.url | json | safe }}{% endif %}}
  </script>
  {%- endif %}
</head>
<body class="{{ bodyClass }}">
  <a class="skip-link" href="#main">Skip to content</a>

  <header class="site-header" data-header>
    <div class="wrap header-inner">
      <a class="brand" href="/" aria-label="{{ site.name }}, home">
        <img class="brand-mark" src="/assets/img/monogram.png" alt="" width="157" height="160" eleventy:ignore>
        <span class="brand-name">{{ site.name }}</span>
      </a>
      <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
        <span class="sr-only">Menu</span>
        <span class="nav-toggle-bars" aria-hidden="true"></span>
      </button>
      <nav class="site-nav" id="site-nav" aria-label="Main">
        <ul>
          <li><a href="/work/"{% if page.url.startsWith("/work") %} aria-current="page"{% endif %}>Work</a></li>
          <li><a href="/about/"{% if page.url == "/about/" %} aria-current="page"{% endif %}>About</a></li>
          <li><a href="/contact/"{% if page.url == "/contact/" %} aria-current="page"{% endif %}>Contact</a></li>
          <li><a class="nav-instagram" href="{{ site.instagram.url }}" rel="me noopener" target="_blank">Instagram</a></li>
        </ul>
      </nav>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div class="footer-brand">
        <img class="footer-mark" src="/assets/img/monogram.png" alt="" width="157" height="160" loading="lazy" eleventy:ignore>
        <p class="footer-name">{{ site.name }}</p>
        <p class="footer-tag">Contemporary abstract paintings.<br>Studio in {{ site.studio }}.</p>
      </div>
      <nav class="footer-col" aria-label="Footer">
        <h2 class="footer-head">Explore</h2>
        <ul>
          <li><a href="/work/">All work</a></li>
          <li><a href="/work/?filter=available">Available paintings</a></li>
          <li><a href="/about/">About</a></li>
          <li><a href="/contact/">Contact</a></li>
        </ul>
      </nav>
      <div class="footer-col">
        <h2 class="footer-head">Say hello</h2>
        <ul>
          <li><a href="/contact/" data-email data-u="{{ site.email.user }}" data-d="{{ site.email.domain }}" data-email-text>Send an email</a></li>
          <li><a href="{{ site.instagram.url }}" rel="me noopener" target="_blank">@{{ site.instagram.handle }} on Instagram</a></li>
        </ul>
      </div>
    </div>
    <div class="wrap footer-base">
      <p>© {{ "" | year }} {{ site.name }}. All artwork and images © the artist.</p>
      <a href="/privacy/">Privacy</a>
    </div>
  </footer>
</body>
</html>
